{
  "name": "seo-notary-browser",
  "version": "0.1.0",
  "description": "Optional Playwright adapter for SEO Notary: compares raw HTML with the rendered DOM.",
  "license": "MIT",
  "author": "Raxocode <engineering@raxocode.com> (https://raxocode.com)",
  "homepage": "https://seonotary.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raxocode/seo-notary.git",
    "directory": "packages/browser"
  },
  "bugs": {
    "url": "https://github.com/raxocode/seo-notary/issues"
  },
  "keywords": [
    "seo",
    "playwright",
    "rendering",
    "hydration",
    "ai-agents"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "playwright-core": "1.64.1",
    "seo-notary-core": "0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
